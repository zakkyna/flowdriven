{
  "name": "flowdriven-workspace",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "test:tools": "node --test \"tools/checks/test/*.test.mjs\"",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:hidden && pnpm check:deps",
    "check:hidden": "node tools/checks/hidden-chars.mjs",
    "check:deps": "node tools/checks/dependency-gate.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p packages/contracts && tsc -p packages/fixtures && tsc -p packages/sdk && tsc -p packages/runner && tsc -p apps/desktop && tsc -p apps/desktop/tsconfig.electron.json --noEmit",
    "test": "TZ=UTC vitest run && pnpm test:tools",
    "build:web": "vite build --config apps/desktop/vite.config.mts",
    "dev:web": "vite --config apps/desktop/vite.config.mts",
    "preview:web": "vite preview --config apps/desktop/vite.config.mts",
    "build:electron": "tsc -p apps/desktop/tsconfig.electron.json",
    "build": "pnpm build:web && pnpm build:electron",
    "start": "pnpm build && pnpm --filter @flowdriven/desktop exec electron .",
    "capture": "pnpm build && TZ=UTC pnpm --filter @flowdriven/desktop exec electron dist-electron/capture.js"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@biomejs/biome": "2.6.3",
    "vite": "8.3.5",
    "@vitejs/plugin-react": "6.1.2",
    "vitest": "5.0.5",
    "happy-dom": "21.0.4",
    "@types/node": "24.19.2"
  }
}
